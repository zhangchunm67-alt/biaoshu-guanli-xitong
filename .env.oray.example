# 复制为本目录 .env.oray 后填写。不要提交真实口令。
# 花生壳客户端把外网域名映射到本机 127.0.0.1:8766（映射口，不可下载材料）
# 本机查看材料请用 127.0.0.1:8767（默认映射口+1，勿做花生壳映射）

# 花生壳分配的访问域名（不要带 http://，可带端口）
ORAY_PUBLIC_HOST=你的域名.imwork.net

# 至少 8 位访问口令；外网打开系统时需输入
ORAY_ACCESS_TOKEN=请改成足够长的口令

# 可选，默认 8766（花生壳映射口）
# ORAY_PORT=8766

# 可选，本机材料入口，默认 ORAY_PORT+1
# ORAY_INTRANET_PORT=8767
