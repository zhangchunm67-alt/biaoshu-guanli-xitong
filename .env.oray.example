# 复制为本目录 .env.oray 后填写。不要提交真实口令。
# 详细说明见《局域网与节点访问方案.md》。
#
# 三个入口：
#   远程口 8766：同事通过花生壳、腾宝AI WiFi 局域网或节点访问，需口令，材料原件与导出不可用
#   本机口 8767：只在服务器这台电脑上打开（127.0.0.1），可维护材料库、审核投稿、导出 Word

# 花生壳分配的访问域名（不要带 http://，可带端口）。不用花生壳可留空。
ORAY_PUBLIC_HOST=

# 局域网 / 节点访问地址，逗号分隔，须写成同事浏览器地址栏里的样子（IP 或域名:端口）。
# 例：腾宝AI WiFi 下服务器固定 IP 192.168.1.20，节点虚拟 IP 10.8.0.5：
# ORAY_LAN_HOSTS=192.168.1.20:8766,10.8.0.5:8766
# 填写后远程口会监听所有网卡；留空则只给本机花生壳客户端连接。
ORAY_LAN_HOSTS=

# 访问口令，至少 12 个字符，可用中文；同事打开系统时输入。
ORAY_ACCESS_TOKEN=

# 可选，默认 8766（远程口）
# ORAY_PORT=8766

# 可选，本机材料入口，默认 ORAY_PORT+1
# ORAY_INTRANET_PORT=8767
