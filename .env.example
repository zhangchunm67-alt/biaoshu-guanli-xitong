# Copy to .env.local after filling credentials. Never commit a real key.
#
# OpenRouter (推荐)
# Docs: https://openrouter.ai/docs/api/reference/overview
# Endpoint: POST https://openrouter.ai/api/v1/chat/completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
BID_API_STYLE=chat
BID_OPENAI_MODEL=deepseek/deepseek-v4.1-flash-1017
# Frontend selectable allowlist (comma-separated). Default model is always included.
BID_OPENAI_MODELS=deepseek/deepseek-v4.1-flash-1017,moonshotai/kimi-k3.1-pro,qwen/qwen3.8-max-0902,z-ai/glm-5.3
BID_REASONING_EFFORT=medium
BID_WRITING_ENABLED=on
# Optional; leave empty to use BID_OPENAI_MODEL.
BID_WRITING_MODEL=
# Case-image OCR via local PaddleOCR (requires requirements-ocr.txt). on|off
BID_CASE_OCR=on

# Optional: force chat/completions or OpenAI Responses. Auto-detected from BASE_URL.
# BID_API_STYLE=chat
#
# DeepSeek 直连（备选）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# BID_OPENAI_MODEL=deepseek-flash
